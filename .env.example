# Copy to .env and edit. docker compose reads this file automatically.
API_KEY=                 # leave empty to disable auth; otherwise send X-API-Key header
CORS_ORIGINS=*           # e.g. https://nikhil-creat.github.io
MAX_UPLOAD_MB=200
MAX_SESSIONS=50

# Free AI assistant keys. Put either key in either variable: the provider is detected from the key
# (Groq keys start with gsk_, Gemini keys with AIza) and the best available model is auto-selected.
# Never commit this file. Get keys at console.groq.com and aistudio.google.com.
GROQ_API_KEY=
GEMINI_API_KEY=
